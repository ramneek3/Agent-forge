# AgentForge environment variables
# Copy to .env and fill in secrets. Never commit .env.

APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
ADMIN_API_KEY=agentforge-admin-dev-key
AUTH_ENABLED=false

# Database (Postgres + pgvector in Docker; SQLite for local tests)
DATABASE_URL=postgresql+asyncpg://agentforge:agentforge@localhost:5432/agentforge
DATABASE_URL_SYNC=postgresql://agentforge:agentforge@localhost:5432/agentforge
USE_SQLITE=false

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# LLM providers — leave empty and set LLM_MOCK_MODE=true for local demos
LLM_MOCK_MODE=true
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
USE_LOCAL_EMBEDDINGS=true
EMBEDDING_DIMENSION=384

# RAG
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.35

# Runtime
MAX_AGENT_ITERATIONS=5
MAX_PROMPT_LENGTH=16000
LOG_FULL_PROMPTS=false
UPLOAD_DIR=./uploads
RATE_LIMIT_PER_MINUTE=120
METRICS_ENABLED=true
